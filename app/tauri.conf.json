{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSB Model Optimizer",
  "version": "0.1.0",
  "identifier": "com.downloadcstrike.modeloptimizer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSB Model Optimizer · downloadcstrike.com",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "downloadcstrike.com",
    "copyright": "© 2026 downloadcstrike.com",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
